{
  "name": "reflectai-backend",
  "version": "1.0.0",
  "description": "ReflectAI Node.js backend \u2014 API, conversation pipeline, AI integration, privacy-first",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
